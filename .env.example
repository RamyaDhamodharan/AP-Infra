POSTGRES_USER=ap_user
POSTGRES_PASSWORD=set-a-local-postgres-password
POSTGRES_DB=genworx_ap
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
USE_CELERY=true
ENABLE_GOODS_RECEIPT=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=set-a-local-minio-password
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ap-documents
MINIO_SECURE=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEST_MAILBOX_ALLOWLIST=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true
EMAIL_PROVIDER=imap
EMAIL_POLL_ENABLED=false
EMAIL_POLL_INTERVAL_SECONDS=300
EMAIL_MAX_ATTEMPTS=5
EMAIL_SENDER_BLOCKLIST=no-reply,noreply,mailer-daemon,postmaster
EMAIL_POLL_MAX_MESSAGES=25
EMAIL_ATTACHMENT_MIN_BYTES=5120
EMAIL_ATTACHMENT_MAX_BYTES=20971520
EMAIL_BODY_PREVIEW_MAX_CHARS=5000
CLASSIFY_MIN_CONFIDENCE=0.6
VITE_AUTH_API_BASE_URL=http://localhost:8001
VITE_AP_API_BASE_URL=http://localhost:8000
